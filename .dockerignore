# Keep the Docker build context small and secret-free.

# VCS / editor / agent scratch
.git
.gitignore
.claude
.github
.idea
.vscode
.DS_Store
.superpowers
skills-lock.json
AGENTS.md
CLAUDE.md

# Python envs / caches
.venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
*.egg-info

# App runtime state / data (never bake into the image)
.cache
data
contextual_cache
*.duckdb
qdrant_storage
pgdata

# Eval run artifacts
eval/runs
*.results.json

# Local env / secrets
.env
.env.local
infra/.env

# Docs and tests (not needed at runtime; keep image small).
#
# Excluding README.md is only safe because the Dockerfile builds with
# `uv sync --no-install-project`. Installing the project runs hatchling, which
# reads `readme = "README.md"` from pyproject.toml and fails the build with
# `OSError: Readme file does not exist: README.md`.
docs
tests
README.md
Project 1 — Production RAG.md

# Misc
node_modules
.audit
.remember
.worktrees
.agents
payload.json
