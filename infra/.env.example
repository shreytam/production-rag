# ─────────────────────────────────────────────────────────────────────────────
# Copy to repo root as `.env` and fill in keys.  One NVIDIA NIM key drives the
# whole stack by default.  Flip any provider by changing the values below — no
# code changes required.
# ─────────────────────────────────────────────────────────────────────────────

# Shared keys (used as fallback by every component below)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Vector store (Qdrant is the only backend) ────────────────────────────────
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
# PG_DSN backs the Postgres document registry (see async ingestion below).
# The compose stack runs ONE postgres:17 server holding two separate databases:
# `rag` (this DSN) and `langfuse` (the stack's own DATABASE_URL, set in
# docker-compose.yml). Different databases, different roles — never mix them.
PG_DSN=postgresql://rag:rag@localhost:5432/rag

# ── Embeddings (OpenAI-compatible). EMBED_DIMENSION must match the model. ────
# NIM default: baai/bge-m3 (1024, multilingual).  Alt: nvidia/nv-embedqa-e5-v5 (1024).
# OpenAI: text-embedding-3-large (3072).
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=baai/bge-m3
EMBED_DIMENSION=1024
EMBED_API_KEY=

# ── Generation (answer synthesis): "openai" (= NIM via OpenAI SDK) | "anthropic"
GEN_PROVIDER=openai
GEN_BASE_URL=https://integrate.api.nvidia.com/v1
GEN_MODEL=meta/llama-3.3-70b-instruct
GEN_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Cheap model for the per-chunk contextual prefix ──────────────────────────
CONTEXT_PROVIDER=openai
CONTEXT_BASE_URL=https://integrate.api.nvidia.com/v1
CONTEXT_MODEL=meta/llama-3.1-8b-instruct

# ── LLM judge / RAGAS backing model ──────────────────────────────────────────
JUDGE_PROVIDER=openai
JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
JUDGE_MODEL=meta/llama-3.3-70b-instruct

# ── Reranker: "local" (BGE cross-encoder) | "nim" | "openrouter" ────────────────────────────
RERANKER=local
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_NIM_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
RERANKER_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Guardrails (input injection/PII + output citation/schema/groundedness) ───
# On for the api/demo query path. The eval harness forces this OFF internally
# (blocking guards would confound metrics; groundedness adds an LLM call/item).
GUARDRAILS_ENABLED=true

# ── Retrieval / assembly ─────────────────────────────────────────────────────
RRF_K=60
RETRIEVE_TOP_K=20
RERANK_TOP_N=8
CONTEXT_TOKEN_BUDGET=4000

# ── Ingest sizing (respect NIM ~40 req/min free tier) ────────────────────────
MAX_CHUNKS_PER_CORPUS=2000

# ── Async document ingestion (POST /documents → arq worker) ──────────────────
# The API enqueues jobs to Redis; the `ingest-worker` compose service drains
# them. Inside compose the worker overrides REDIS_URL/QDRANT_URL/PG_DSN with the
# in-cluster service DNS; the values here target a host-run process.
REDIS_URL=redis://localhost:6379
# Registry backend: "postgres" (shared between API and worker) | "memory" (dev,
# single-process only — the worker won't see the API's rows across processes).
DOC_REGISTRY_BACKEND=postgres
DOC_REGISTRY_TABLE=documents
# Raw-upload blob store (local disk now; the worker reads what the API wrote, so
# both must see the same path — shared via the repo bind-mount in compose).
BLOB_STORE_ROOT=.cache/uploads
MAX_UPLOAD_BYTES=26214400          # 25 MiB; POST /documents is exempt from any
                                   # global request-body cap and uses this instead
# Comma-separated content-type allowlist for uploads (unset ⇒ built-in default).
# INGEST_ALLOWED_TYPES=text/plain,text/markdown,application/pdf

# ── Observability (Langfuse v3+ — SDK v4) ────────────────────────────────────
# Self-hosted v3 stack via docker-compose -> http://localhost:3000
# Langfuse Cloud (no local stack) -> https://cloud.langfuse.com (or .us)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Auth & tenancy (SP1) ---
# Dev defaults: HS256 with a local secret + dev signer on. NEVER use these in prod.
APP_ENV=dev
JWT_ALG=HS256
JWT_SECRET=change-me-dev-secret
# JWKS_URL=            # RS256/prod only
JWT_ISSUER=
JWT_AUDIENCE=
JWT_LEEWAY_SECONDS=60
# ACL_ALLOWLIST_SOURCE=config/acl_allowlist.json   # optional per-tenant tag grants
AUTH_DEV_SIGNER_ENABLED=true
MAX_QUESTION_CHARS=8000
MAX_ACL_TAGS=32

# --- Semantic cache (Redis 8 / redis-vl; opt-in) ---
CACHE_ENABLED=false
CACHE_SIMILARITY_THRESHOLD=0.97   # higher = fewer false cache hits
CACHE_TTL_SECONDS=3600

# ─────────────────────────────────────────────────────────────────────────────
# Additional keys (every Settings field is documented here; enforced by
# tests/test_env_example_drift.py)
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI-compatible router (one base URL + key for every chat role) ────────
# Chat roles left at the NIM default URL / empty key inherit these. Embeddings
# and the reranker are NOT routed.
OPENROUTER_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=

# ── Per-role API keys (empty = fall back to the shared keys above) ───────────
CONTEXT_API_KEY=
JUDGE_API_KEY=
RERANKER_NIM_API_KEY=
RERANKER_OPENROUTER_API_KEY=

# ── Anthropic role models (used when *_PROVIDER=anthropic) ───────────────────
ANTHROPIC_CONTEXT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-6

# ── Reranker via OpenRouter (RERANKER=openrouter) ────────────────────────────
RERANKER_OPENROUTER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RERANKER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── HTTP resilience ──────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=600.0      # per-request ceiling for provider calls
MAX_RETRIES=5                      # SDK-level automatic retries

# ── Embedding batching ───────────────────────────────────────────────────────
EMBED_BATCH_SIZE=64

# ── Chunking / context assembly ──────────────────────────────────────────────
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP=200                  # must be < CHUNK_MAX_TOKENS
CONTEXT_TOKENIZER=auto
CONTEXT_TOKEN_SAFETY_MARGIN=0.0

# ── Sparse (BM25) / ingest on-disk state ─────────────────────────────────────
HYBRID_REQUIRE_SPARSE=true         # currently has no effect (kept for compatibility)
SPARSE_INDEX_DIR=.cache
TENANT_SPARSE_DIR=.cache/sparse_tenants
CONTEXTUAL_CACHE_DIR=.cache/contextual
MANIFEST_DIR=.cache/manifest

# ── Guardrail tuning ─────────────────────────────────────────────────────────
INJECTION_LLM_ESCALATION=true      # borderline input -> one LLM classifier call
GROUNDEDNESS_TIMEOUT_SECONDS=20.0  # wall-clock bound on the faithfulness call

# ── PII & compliance ─────────────────────────────────────────────────────────
PII_MODE=redact                    # redact | keep
# regex = fast heuristic detector (dev). APP_ENV=prod REQUIRES presidio.
PII_DETECTOR=regex
PII_SCAN_OUTPUT=true
PII_AUDIT_LOG_PATH=.audit/pii_audit.jsonl
PII_AUDIT_VALUE_HASH=false
# Required (non-empty) when PII_AUDIT_VALUE_HASH=true, to prevent hash brute-forcing.
# PII_AUDIT_HASH_SALT=

# ── Observability ────────────────────────────────────────────────────────────
LANGFUSE_SAMPLE_RATE=1.0

# ── Redis / worker ───────────────────────────────────────────────────────────
# Used by the API rate limiter. NOTE: REDIS_URL (arq worker, semantic cache) does
# NOT read this value — embed the password in REDIS_URL itself
# (redis://:password@host:6379) for those.
REDIS_PASSWORD=
INGEST_QUEUE_NAME=ingest

# ── Query rewriting / synonym expansion ──────────────────────────────────────
REWRITER_ENABLED=true
REWRITER_LLM_ENABLED=true
REWRITER_LLM_THRESHOLD=5

# ── CI gating ────────────────────────────────────────────────────────────────
# true = live-store tests FAIL instead of skipping when Qdrant/Redis/PG are down.
RAG_REQUIRE_LIVE_STORES=false

# ── Keys added by parallel hardening branches (Settings fields land on merge) ─
QDRANT_API_KEY=                    # Qdrant API key (empty = unauthenticated)
AUTH_DEV_SIGNER_ALLOW_REMOTE=false # allow the dev token signer from non-loopback clients
QUERY_REQUEST_TIMEOUT_SECONDS=30.0
QUERY_MAX_RETRIES=1
INGEST_JOB_TIMEOUT_SECONDS=900
INGEST_MAX_TRIES=3
INGEST_STALE_AFTER_SECONDS=3600
INGEST_SWEEP_INTERVAL_MINUTES=5
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_QUERY_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=20
